# ANANTA Multi-Agent Engine Configuration
# Copy this file to .env and modify as needed

# Ollama Configuration (optional - enables real LLM for StoryAgent)
# Set OLLAMA_MODEL to enable Ollama integration
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT=120
# OLLAMA_MAX_RETRIES=3
# OLLAMA_TEMPERATURE=0.7

# Future provider configurations (not used in Phase 1)
# RUNWAY_API_KEY=
# ELEVENLABS_API_KEY=
# SUNO_API_KEY=
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=